{
  "name": "llm-gateway-admin-console",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test -c playwright.demo.config.ts",
    "test:break:demo": "node scripts/break-demo-checks.mjs",
    "test:break": "node scripts/break-checks.mjs",
    "test:break:policies": "node scripts/break-policy-checks.mjs",
    "test:break:console": "node scripts/break-console-checks.mjs"
  },
  "dependencies": {
    "iron-session": "9.0.1",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
