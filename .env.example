# Copy to .env and fill in. .env is git-ignored: never commit real keys.
#
# Step 1 forwards to ONE OpenAI-compatible provider. Pick one:
#   Groq:     https://api.groq.com/openai/v1
#   DeepSeek: https://api.deepseek.com/v1
#   Gemini:   https://generativelanguage.googleapis.com/v1beta/openai
GATEWAY_UPSTREAM_PROVIDER=groq   # groq | gemini | deepseek | openai
GATEWAY_UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
GATEWAY_UPSTREAM_API_KEY=

# json in production, console for reading locally
GATEWAY_LOG_FORMAT=console
GATEWAY_LOG_LEVEL=INFO
