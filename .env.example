# Copy to .env and fill in. .env is git-ignored: never commit real keys.
#
# Uncomment and fill at least one key. Leave unused providers commented out.
# GATEWAY_PROVIDERS__GROQ__API_KEY=
# GATEWAY_PROVIDERS__DEEPSEEK__API_KEY=
# GATEWAY_PROVIDERS__GEMINI__API_KEY=
# GATEWAY_PROVIDERS__OPENAI__API_KEY=
# Required: use unique private values, not the examples in the documentation.
# GATEWAY_API_KEY_PEPPER=<random 32+ byte secret>
GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:local-only-example@127.0.0.1:5432/gateway
GATEWAY_REDIS_URL=redis://127.0.0.1:6379/0
# GATEWAY_LIMITS__DEFAULT_RPM=0
# GATEWAY_LIMITS__DEFAULT_TPM=0
# GATEWAY_LIMITS__DEFAULT_MAX_CONCURRENCY=0
# GATEWAY_LIMITS__DEFAULT_MONTHLY_BUDGET_USD=0
# GATEWAY_LIMITS__DEFAULT_ALERT_THRESHOLD=0.8
# GATEWAY_LIMITS__IP_FAILURES_PER_MINUTE=20
# GATEWAY_LIMITS__LEASE_TTL_S=900
# GATEWAY_LIMITS__FAIL_MODE=open
# GATEWAY_TRUSTED_PROXY_HOPS=0
# Optional file-per-secret deployment: files named api_key_pepper, database_url, redis_url,
# providers__groq__api_key, etc. Directory and files must not be accessible by others.
# GATEWAY_SECRETS__BACKEND=file
# GATEWAY_SECRETS__DIR=/run/secrets/gateway
# GATEWAY_KEY_CACHE_TTL_S=30
# GATEWAY_KEY_CACHE_MAX_SIZE=10000
# Optional overrides; defaults are declared in providers/defaults.py.
# GATEWAY_PROVIDERS__GROQ__BASE_URL=https://api.groq.com/openai/v1

# json in production, console for reading locally
GATEWAY_LOG_FORMAT=console
GATEWAY_LOG_LEVEL=INFO
