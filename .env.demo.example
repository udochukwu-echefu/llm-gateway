# PORT must equal image EXPOSE and InstaCloud --port.
PORT=3000
DATABASE_URL=postgresql://DEMO_USER:GENERATED_PASSWORD@POSTGRES_HOST:5432/DEMO_DB
REDIS_URL=redis://REDIS_HOST:6379/0
GATEWAY_API_KEY_PEPPER=REPLACE_WITH_GENERATED_32_PLUS_BYTE_SECRET
GATEWAY_CACHE_ENCRYPTION_KEY=REPLACE_WITH_URLSAFE_BASE64_ENCODED_32_RANDOM_BYTES
ADMIN_CONSOLE_SESSION_SECRET=REPLACE_WITH_GENERATED_32_PLUS_BYTE_SECRET
ADMIN_CONSOLE_ORIGIN=https://demo.example.invalid
ADMIN_CONSOLE_TRUSTED_PROXY_HOPS=0
# Boot keys are generated in memory. Never add DEMO_VIEWER_KEY or DEMO_TENANT_KEY here.
